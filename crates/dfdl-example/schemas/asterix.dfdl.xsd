<?xml version="1.0" encoding="UTF-8"?>
<!--
  EUROCONTROL ASTERIX (All Purpose STructured Eurocontrol suRveillance Information EXchange)
  DFDL Definition for Categories:
    - Category 034: Transmission of Monoradar Service Messages (Ed 1.27)
    - Category 048: Transmission of Monoradar Target Reports (Ed 1.21)
    - Category 001: Transmission of Monoradar Data (Ed 1.2)
    - Category 002: Transmission of Monoradar Service Messages (Ed 1.0)
-->
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/"
    xmlns:dfdlx="http://www.ogf.org/dfdl/dfdl-1.0/extensions"
    xmlns:fn="http://www.w3.org/2005/xpath-functions"
    xmlns:ast="urn:eurocontrol:asterix">

  <xs:annotation>
    <xs:appinfo source="http://www.ogf.org/dfdl/">
      <dfdl:format
          representation="binary"
          byteOrder="bigEndian"
          bitOrder="mostSignificantBitFirst"
          binaryNumberRep="binary"
          lengthUnits="bytes"
          alignment="1"
          alignmentUnits="bytes"
          lengthKind="implicit"
          leadingSkip="0"
          trailingSkip="0"
          initiator=""
          terminator=""
          separator=""
          encoding="ISO-8859-1"
          textBidi="no"
          floating="no"
          fillByte="%#r00;"
          occursCountKind="implicit"
      />
    </xs:appinfo>
  </xs:annotation>

  <!-- ========================================================================= -->
  <!-- Top-Level Root Elements                                                   -->
  <!-- ========================================================================= -->

  <!-- Top-level Network Packet / UDP Datagram containing one or more ASTERIX Data Blocks -->
  <xs:element name="AsterixPacket" type="AsterixPacketType"/>
  <xs:element name="AsterixDatagram" type="AsterixPacketType"/>

  <xs:complexType name="AsterixPacketType">
    <xs:sequence>
      <xs:element ref="AsterixRecord" minOccurs="1" maxOccurs="unbounded" dfdl:occursCountKind="parsed"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Top-level polymorphic ASTERIX Record (Data Block) with O(1) Category dispatch -->
  <xs:element name="AsterixRecord" dfdl:lengthKind="explicit" dfdl:length="{ dfdlx:lookAhead(8, 16) }" dfdl:lengthUnits="bytes">
    <xs:complexType>
      <xs:choice dfdl:choiceDispatchKey="{ xs:string(dfdlx:lookAhead(0, 8)) }">
        <xs:element ref="Cat034Record" dfdl:choiceBranchKey="34"/>
        <xs:element ref="Cat048Record" dfdl:choiceBranchKey="48"/>
        <xs:element ref="Cat001Record" dfdl:choiceBranchKey="1"/>
        <xs:element ref="Cat002Record" dfdl:choiceBranchKey="2"/>
      </xs:choice>
    </xs:complexType>
  </xs:element>

  <!-- Individual Category Root Elements -->
  <xs:element name="Cat034Record" type="Cat034RecordType" dfdl:lengthKind="explicit" dfdl:length="{ dfdlx:lookAhead(8, 16) }" dfdl:lengthUnits="bytes"/>
  <xs:element name="Cat048Record" type="Cat048RecordType" dfdl:lengthKind="explicit" dfdl:length="{ dfdlx:lookAhead(8, 16) }" dfdl:lengthUnits="bytes"/>
  <xs:element name="Cat001Record" type="Cat001RecordType" dfdl:lengthKind="explicit" dfdl:length="{ dfdlx:lookAhead(8, 16) }" dfdl:lengthUnits="bytes"/>
  <xs:element name="Cat002Record" type="Cat002RecordType" dfdl:lengthKind="explicit" dfdl:length="{ dfdlx:lookAhead(8, 16) }" dfdl:lengthUnits="bytes"/>

  <!-- ========================================================================= -->
  <!-- ASTERIX Numerical Simple Types with Quanta and Field Descriptions        -->
  <!-- ========================================================================= -->

  <!-- ASTERIX Data Category (1 octet: 0 to 255) -->
  <xs:simpleType name="DataCategoryType">
    <xs:annotation>
      <xs:documentation>
        ASTERIX Data Category.
        Identifies the message category according to Eurocontrol ASTERIX standards:
        - Cat 034: Transmission of Monoradar Service Messages (Ed 1.28)
        - Cat 048: Transmission of Monoradar Target Reports (Ed 1.21)
        - Cat 001: Transmission of Monoradar Data (Ed 1.2)
        - Cat 002: Transmission of Monoradar Service Messages (Ed 1.0)
        Quantum: 1 (category number). Unit: dimensionless. Range: 0 to 255.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>Data Category</ast:item>
        <ast:description>ASTERIX Data Category number</ast:description>
        <ast:unit>dimensionless</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="255"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ASTERIX Data Block Length (2 octets: 3 to 65535 bytes) -->
  <xs:simpleType name="BlockLengthType">
    <xs:annotation>
      <xs:documentation>
        ASTERIX Data Block Length.
        Total length of the data block in octets, including the Category field (1 octet)
        and the Length field itself (2 octets). Minimum valid length is 3 octets.
        Quantum: 1 octet (byte). Unit: bytes. Range: 3 to 65535 bytes.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>Length Indicator</ast:item>
        <ast:description>Total length of ASTERIX Data Block in bytes</ast:description>
        <ast:unit>bytes</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1 byte</ast:lsb>
        <ast:range min="3" max="65535"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="3"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Data Source Identifier: SAC / SIC (1 octet: 0 to 255) -->
  <xs:simpleType name="DataSourceIdType">
    <xs:annotation>
      <xs:documentation>
        Item 010: Data Source Identifier (SAC / SIC).
        - SAC (System Area Code): Identifies the nation/region or airspace division.
        - SIC (System Identification Code): Identifies the radar sensor system within the SAC.
        Quantum: 1. Unit: dimensionless code. Range: 0 to 255.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/010, I048/010, I001/010, I002/010</ast:item>
        <ast:description>Data Source Identifier (SAC / SIC)</ast:description>
        <ast:unit>code</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="255"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- System Area Code (SAC): 1 octet (0 to 255) -->
  <xs:simpleType name="SacType">
    <xs:annotation>
      <xs:documentation>
        Item 010: System Area Code (SAC).
        Identifies the nation, region, or airspace division.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/010-SAC, I048/010-SAC, I001/010-SAC</ast:item>
        <ast:description>System Area Code (SAC)</ast:description>
        <ast:unit>code</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="255"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- System Identification Code (SIC): 1 octet (0 to 255) -->
  <xs:simpleType name="SicType">
    <xs:annotation>
      <xs:documentation>
        Item 010: System Identification Code (SIC).
        Identifies the radar sensor station within the SAC.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/010-SIC, I048/010-SIC, I001/010-SIC</ast:item>
        <ast:description>System Identification Code (SIC)</ast:description>
        <ast:unit>code</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="255"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Field Specification (FSPEC) Primary Octet -->
  <xs:simpleType name="Fspec1Type">
    <xs:annotation>
      <xs:documentation>FSPEC Octet 1: Primary field specification.</xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:description>Field Specification (FSPEC 1)</ast:description>
        <ast:unit>bitfield</ast:unit>
        <ast:resolution>1</ast:resolution>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte"/>
  </xs:simpleType>

  <!-- Field Specification (FSPEC) First Extension -->
  <xs:simpleType name="Fspec2Type">
    <xs:annotation>
      <xs:documentation>FSPEC Octet 2: First extension field specification.</xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:description>Field Specification (FSPEC 2)</ast:description>
        <ast:unit>bitfield</ast:unit>
        <ast:resolution>1</ast:resolution>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte"/>
  </xs:simpleType>

  <!-- Field Specification (FSPEC) Second Extension -->
  <xs:simpleType name="Fspec3Type">
    <xs:annotation>
      <xs:documentation>FSPEC Octet 3: Second extension field specification.</xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:description>Field Specification (FSPEC 3)</ast:description>
        <ast:unit>bitfield</ast:unit>
        <ast:resolution>1</ast:resolution>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte"/>
  </xs:simpleType>

  <!-- Target Identification / Callsign: 8 characters encoded in 6-bit ICAO -->
  <xs:simpleType name="AircraftIdType">
    <xs:annotation>
      <xs:documentation>
        Item 240: Target Identification (Callsign).
        8 characters representing the aircraft callsign.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/240</ast:item>
        <ast:description>Target Identification (Callsign)</ast:description>
        <ast:unit>string</ast:unit>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:string"/>
  </xs:simpleType>

  <!-- BDS Report Repetition Factor -->
  <xs:simpleType name="BdsRepType">
    <xs:annotation>
      <xs:documentation>
        Item 250: BDS Report Repetition Factor.
        Number of BDS reports following.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/250-REP</ast:item>
        <ast:description>BDS Report Repetition Factor</ast:description>
        <ast:unit>count</ast:unit>
        <ast:resolution>1</ast:resolution>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte"/>
  </xs:simpleType>

  <!-- Message Type: Category 034 / 002 (1 to 255) -->
  <xs:simpleType name="MessageTypeType">
    <xs:annotation>
      <xs:documentation>
        Item 000: Message Type.
        Defines the service message type for Monoradar Service Messages:
        - 1: North Marker Message
        - 2: Sector Crossing Message
        - 3: Geographical Filtering Message (Cat 034) / Station Status Message (Cat 002)
        - 4: Jamming Strobe Message
        - 5: Solar Storm Message
        - 6: SSR Jamming Strobe Message
        - 7: Mode S Jamming Strobe Message
        - 8..255: Other service / reserved messages
        Quantum: 1. Unit: message type ID. Range: 1 to 255.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/000, I002/000</ast:item>
        <ast:description>Service Message Type</ast:description>
        <ast:unit>type_id</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="1" max="255"/>
        <ast:enum value="1" label="North Marker Message"/>
        <ast:enum value="2" label="Sector Crossing Message"/>
        <ast:enum value="3" label="Geographical Filtering Message"/>
        <ast:enum value="4" label="Jamming Strobe Message"/>
        <ast:enum value="5" label="Solar Storm Message"/>
        <ast:enum value="6" label="SSR Jamming Strobe Message"/>
        <ast:enum value="7" label="Mode S Jamming Strobe Message"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Time of Day (24-bit unsigned integer, LSB = 1/128 s: 0 to 16777215) -->
  <xs:simpleType name="TimeOfDayType">
    <xs:annotation>
      <xs:documentation>
        Item 030 / 140: Time of Day.
        Absolute time stamping expressed as UTC elapsed time since midnight.
        Quantum (LSB): 1/128 s (~7.8125 milliseconds).
        Unit: seconds.
        Range: [0 s, 24 h) = [0, 86400 s) represented as integer [0, 11059200].
        Maximum 24-bit integer: 16777215 (~36.4 hours).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/030, I048/140, I002/030</ast:item>
        <ast:description>Time of Day (UTC since midnight)</ast:description>
        <ast:unit>seconds</ast:unit>
        <ast:resolution>1/128</ast:resolution>
        <ast:lsb>0.0078125 s (1/128 s)</ast:lsb>
        <ast:range min="0" max="86400"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedInt">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="16777215"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Truncated Time of Day (16-bit unsigned integer, LSB = 1/128 s: 0 to 65535) -->
  <xs:simpleType name="TruncatedTimeOfDayType">
    <xs:annotation>
      <xs:documentation>
        Item 141: Truncated Time of Day.
        Time of day truncated to the 16 least significant bits of the standard Time of Day.
        Quantum (LSB): 1/128 s (~7.8125 milliseconds).
        Unit: seconds.
        Range: [0 s, 512 s) represented as [0, 65535] (wraps around every 512 seconds).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I001/141</ast:item>
        <ast:description>Truncated Time of Day</ast:description>
        <ast:unit>seconds</ast:unit>
        <ast:resolution>1/128</ast:resolution>
        <ast:lsb>0.0078125 s (1/128 s)</ast:lsb>
        <ast:range min="0" max="511.9921875"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Sector Number (Azimuth = sector * 360 / 256 deg: 0 to 255) -->
  <xs:simpleType name="SectorNumberType">
    <xs:annotation>
      <xs:documentation>
        Item 020: Sector Number.
        Azimuth sector crossing indicator, dividing 360 degrees into 256 equal angular sectors.
        Quantum (LSB): 360 / 256 degrees = 1.40625 degrees (~1° 24' 22.5").
        Unit: degrees.
        Range: 0 to 255 (= 0.0° to 358.59375° clockwise from True North).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/020, I002/020</ast:item>
        <ast:description>Azimuth Sector Number</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>360/256</ast:resolution>
        <ast:lsb>1.40625 deg</ast:lsb>
        <ast:range min="0" max="358.59375"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Antenna Rotation Period (LSB = 1/128 s: 0 to 65535) -->
  <xs:simpleType name="AntennaRotationPeriodType">
    <xs:annotation>
      <xs:documentation>
        Item 041: Antenna Rotation Period.
        Measured duration of the previous full 360-degree antenna revolution.
        Quantum (LSB): 1/128 s (~7.8125 milliseconds).
        Unit: seconds.
        Range: 0 to 511.9921875 seconds (0 to 65535 LSB).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/041, I002/041</ast:item>
        <ast:description>Antenna Rotation Period</ast:description>
        <ast:unit>seconds</ast:unit>
        <ast:resolution>1/128</ast:resolution>
        <ast:lsb>0.0078125 s (1/128 s)</ast:lsb>
        <ast:range min="0" max="511.9921875"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 3D Height (LSB = 6.25 m or 1 meter: -32768 to 32767 m) -->
  <xs:simpleType name="DataSourceHeightType">
    <xs:annotation>
      <xs:documentation>
        Item 120 (Height Subfield): 3D Position of Data Source - Antenna Height.
        Height of the radar antenna phase center relative to mean sea level in two's complement.
        Quantum (LSB): 6.25 meters (Eurocontrol standard) or 1 meter.
        Unit: meters.
        Range: -32768 to 32767.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/120-HEIGHT</ast:item>
        <ast:description>Antenna Height above Mean Sea Level</ast:description>
        <ast:unit>meters</ast:unit>
        <ast:resolution>6.25</ast:resolution>
        <ast:lsb>6.25 m</ast:lsb>
        <ast:range min="-204800" max="204793.75"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:short">
      <xs:minInclusive value="-32768"/>
      <xs:maxInclusive value="32767"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 24-bit WGS-84 Coordinate (-8388608 to 8388607) -->
  <xs:simpleType name="Wgs84CoordinateType">
    <xs:annotation>
      <xs:documentation>
        Item 120 (Latitude / Longitude Subfields): 3D Position of Data Source in WGS-84.
        Geographic coordinates in two's complement 24-bit binary representation.
        Quantum (LSB): 180 / 2^23 degrees (= 180 / 8388608 deg ~ 0.00002145767 degrees ~ 2.146 cm at equator).
        Unit: degrees.
        Range: [-90.0°, +90.0°] for Latitude; [-180.0°, +180.0°] for Longitude.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/120-LATLON</ast:item>
        <ast:description>WGS-84 Geographic Latitude / Longitude</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>180/8388608</ast:resolution>
        <ast:lsb>0.00002145767 deg</ast:lsb>
        <ast:range min="-180.0" max="180.0"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:minInclusive value="-8388608"/>
      <xs:maxInclusive value="8388607"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Collimation Error (LSB = 360 / 2^16 deg: 0 to 65535) -->
  <xs:simpleType name="CollimationErrorType">
    <xs:annotation>
      <xs:documentation>
        Item 090: Collimation Error.
        Angular alignment error between the PSR axis and the SSR axis.
        Quantum (LSB): 360 / 2^16 degrees (= 360 / 65536 deg ~ 0.005493164 degrees).
        Unit: degrees.
        Range: 0 to 359.9945 degrees.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/090</ast:item>
        <ast:description>Collimation Error</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>360/65536</ast:resolution>
        <ast:lsb>0.005493164 deg</ast:lsb>
        <ast:range min="0" max="359.9945"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Message Count Values (LSB = 1 message: 0 to 65535) -->
  <xs:simpleType name="MessageCountType">
    <xs:annotation>
      <xs:documentation>
        Item 070: Message Count Values.
        Number of messages of the specified type transmitted during the reporting period.
        Quantum (LSB): 1 message.
        Unit: messages.
        Range: 0 to 65535 messages.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I034/070</ast:item>
        <ast:description>Message Count Values</ast:description>
        <ast:unit>messages</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="65535"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Target Report Descriptor (Primary Subfield: 1 octet = 8 bits) -->
  <xs:complexType name="TargetDescriptorType">
    <xs:annotation>
      <xs:documentation>
        Item 020: Target Report Descriptor (Primary Subfield).
        Bitfield identifying target detection characteristics:
        - Bits 8-6 (TYP): Target Report Type (0=No detection, 1=Single PSR, 2=Single SSR, 3=SSR+PSR,
                          4=Single Mode S All-Call, 5=Single Mode S Roll-Call, 6=Mode S All-Call+PSR, 7=Mode S Roll-Call+PSR)
        - Bit 5 (SIM): Simulated Target Report (0=Actual target, 1=Simulated target)
        - Bit 4 (RDP): Report Source (0=Surveillance chain, 1=RDP)
        - Bit 3 (SPI): Special Position Identification (0=Default, 1=SPI active)
        - Bit 2 (RAB): Aircraft Address source (0=Target report, 1=Reply)
        - Bit 1 (FX): Extension indicator (0=End of data item, 1=Extension follows)
        Quantum: Bitfield (1 octet = 8 bits).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/020, I001/020</ast:item>
        <ast:description>Target Report Descriptor</ast:description>
        <ast:unit>bitfield</ast:unit>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence dfdl:alignment="1" dfdl:alignmentUnits="bits">
      <xs:element name="typ" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="3" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>TYP: Target Report Type (0=No detection, 1=Single PSR, 2=Single SSR, 3=SSR+PSR, 4=Single Mode S, 5=Mode S+PSR, 6=Mode S+SSR, 7=Mode S+SSR+PSR)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.TYP</ast:item>
            <ast:description>Target Report Type</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="7"/>
            <ast:enum value="0" label="No detection"/>
            <ast:enum value="1" label="Single PSR"/>
            <ast:enum value="2" label="Single SSR"/>
            <ast:enum value="3" label="SSR + PSR"/>
            <ast:enum value="4" label="Single Mode S"/>
            <ast:enum value="5" label="Mode S + PSR"/>
            <ast:enum value="6" label="Mode S + SSR"/>
            <ast:enum value="7" label="Mode S + SSR + PSR"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="sim" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>SIM: Simulated Target Report (0=Actual, 1=Simulated)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.SIM</ast:item>
            <ast:description>Simulated Target</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
            <ast:enum value="0" label="Actual"/>
            <ast:enum value="1" label="Simulated"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="rdp" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>RDP: Provided by Surveillance Chain (0) vs RDP (1)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.RDP</ast:item>
            <ast:description>Report from RDP</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
            <ast:enum value="0" label="Surveillance chain"/>
            <ast:enum value="1" label="RDP"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="spi" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>SPI: Special Position Identification (0=Default, 1=SPI)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.SPI</ast:item>
            <ast:description>Special Position Identification</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
            <ast:enum value="0" label="Default"/>
            <ast:enum value="1" label="SPI present"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="rab" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>RAB: Report from Target Report (0) vs Reply (1)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.RAB</ast:item>
            <ast:description>Report from Aircraft Address Reply</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
            <ast:enum value="0" label="Report"/>
            <ast:enum value="1" label="Reply"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="fx" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>FX: Extension Indicator (0=End, 1=Extension follows)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.FX</ast:item>
            <ast:description>Extension Bit</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
            <ast:enum value="0" label="End of Field"/>
            <ast:enum value="1" label="Extension follows"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Target Report Descriptor First Extension (1 octet = 8 bits) -->
  <xs:complexType name="TargetDescriptorExtType">
    <xs:annotation>
      <xs:documentation>
        Item 020 First Extension: Extended Target Report Characteristics.
        - Bit 8 (TST): Test Target (0=Real, 1=Test)
        - Bit 7 (ERR): Extended Range Report (0=No error, 1=Error)
        - Bit 6 (XPP): X-Pulse Present (0=No, 1=Yes)
        - Bit 5 (ME): Military Emergency (0=No, 1=Yes)
        - Bit 4 (MI): Military Identification (0=No, 1=Yes)
        - Bits 3-2 (FOE_FRI): Friend / Foe (0=No Mode 4, 1=Friendly, 2=Unknown, 3=No reply)
        - Bit 1 (FX): Extension Indicator (0=End, 1=Extension follows)
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/020-EXT</ast:item>
        <ast:description>Target Report Descriptor Extension</ast:description>
        <ast:unit>bitfield</ast:unit>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence dfdl:alignment="1" dfdl:alignmentUnits="bits">
      <xs:element name="tst" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>TST: Test Target Indicator (0=Real, 1=Test)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.TST</ast:item>
            <ast:description>Test Target Indicator</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="err" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>ERR: Error Condition (0=No error, 1=Error)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.ERR</ast:item>
            <ast:description>Error Condition</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="xpp" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>XPP: X-Pulse Present (0=No, 1=Yes)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.XPP</ast:item>
            <ast:description>X-Pulse Present</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="me" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>ME: Military Emergency (0=No, 1=Yes)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.ME</ast:item>
            <ast:description>Military Emergency</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="mi" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>MI: Military Identification (0=No, 1=Yes)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.MI</ast:item>
            <ast:description>Military Identification</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="foeFri" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="2" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>FOE_FRI: Friend / Foe Identification (0=No Mode 4, 1=Friendly, 2=Unknown, 3=No reply)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.FOE_FRI</ast:item>
            <ast:description>Friend / Foe Identification</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="3"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="fx" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>FX: Extension Indicator (0=End, 1=Extension follows)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/020.FX</ast:item>
            <ast:description>Extension Bit</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Track Number (12 to 16 bits: 0 to 65535) -->
  <xs:simpleType name="TrackNumberType">
    <xs:annotation>
      <xs:documentation>
        Item 161: Track Number.
        Unique tracking identifier assigned to a track by the radar data processor.
        Standard Eurocontrol definition uses bits 12-1 (0 to 4095) with bits 16-13 reserved (0).
        Quantum: 1. Unit: dimensionless integer. Range: 0 to 65535.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/161, I001/161</ast:item>
        <ast:description>Radar Track Number</ast:description>
        <ast:unit>track_id</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="65535"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Measured Distance Rho in Polar Coordinates (LSB = 1/256 NM: 0 to 65535) -->
  <xs:simpleType name="PolarDistanceType">
    <xs:annotation>
      <xs:documentation>
        Item 040 / 100: Measured Distance (Rho) in Polar Coordinates.
        Slant distance between the radar antenna and the target.
        Quantum (LSB): 1/256 NM (= 0.00390625 NM ~ 7.2297 meters).
        Unit: Nautical Miles (NM).
        Range: 0 to 255.99609375 NM (0 to 65535 LSB).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/040-RHO, I034/100-RHO, I001/040-RHO</ast:item>
        <ast:description>Measured Distance Rho in Polar Coordinates</ast:description>
        <ast:unit>NM</ast:unit>
        <ast:resolution>1/256</ast:resolution>
        <ast:lsb>0.00390625 NM (~7.2297 m)</ast:lsb>
        <ast:range min="0" max="255.99609375"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Measured Azimuth Theta in Polar Coordinates (LSB = 360 / 2^16 deg: 0 to 65535) -->
  <xs:simpleType name="PolarAzimuthType">
    <xs:annotation>
      <xs:documentation>
        Item 040 / 100: Measured Azimuth (Theta) in Polar Coordinates.
        Azimuth angle measured clockwise from True North to the target.
        Quantum (LSB): 360 / 2^16 degrees (= 360 / 65536 deg ~ 0.005493164 degrees ~ 19.77 arcseconds).
        Unit: degrees.
        Range: 0 to 359.9945068 degrees (0 to 65535 LSB).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/040-THETA, I034/100-THETA, I001/040-THETA</ast:item>
        <ast:description>Measured Azimuth Theta in Polar Coordinates</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>360/65536</ast:resolution>
        <ast:lsb>0.005493164 deg</ast:lsb>
        <ast:range min="0" max="359.9945068"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Cartesian Coordinate X or Y (LSB = 1/64 or 1/16 NM: -32768 to 32767) -->
  <xs:simpleType name="CartesianCoordinateType">
    <xs:annotation>
      <xs:documentation>
        Item 042: Calculated Position in Cartesian Coordinates (X or Y).
        Position coordinate relative to the radar sensor in signed two's complement.
        Quantum (LSB): 1/64 NM (= 0.015625 NM ~ 28.918 meters) in Cat 048;
                       1/16 NM (= 0.0625 NM ~ 115.67 meters) in Cat 001.
        Unit: Nautical Miles (NM).
        Range: -512.0 NM to +511.984375 NM (-32768 to 32767 LSB at 1/64 NM).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/042, I001/042</ast:item>
        <ast:description>Calculated Position in Cartesian Coordinates (X / Y)</ast:description>
        <ast:unit>NM</ast:unit>
        <ast:resolution>1/64</ast:resolution>
        <ast:lsb>0.015625 NM (~28.918 m)</ast:lsb>
        <ast:range min="-512.0" max="511.984375"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:short">
      <xs:minInclusive value="-32768"/>
      <xs:maxInclusive value="32767"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Ground Speed (LSB = (2^-14) NM/s: 0 to 65535) -->
  <xs:simpleType name="GroundSpeedType">
    <xs:annotation>
      <xs:documentation>
        Item 200 (Ground Speed Subfield): Calculated Track Velocity in Polar Coordinates.
        Horizontal speed of the target calculated by the tracker.
        Quantum (LSB): 2^-14 NM/s (= 1/16384 NM/s ~ 0.2197265625 knots ~ 0.113037 m/s).
        Unit: NM/s (multiply raw value by 3600 / 16384 to obtain speed in knots).
        Range: 0 to 3.99993896 NM/s (~0 to 14399.78 knots).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/200-SPEED, I001/200-SPEED</ast:item>
        <ast:description>Calculated Track Ground Speed</ast:description>
        <ast:unit>NM/s</ast:unit>
        <ast:resolution>1/16384</ast:resolution>
        <ast:lsb>0.00006103515625 NM/s (~0.2197 kt)</ast:lsb>
        <ast:range min="0" max="3.99993896"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Track Heading (LSB = 360 / 2^16 deg: 0 to 65535) -->
  <xs:simpleType name="HeadingType">
    <xs:annotation>
      <xs:documentation>
        Item 200 (Heading Subfield): Calculated Track Heading / Course in Polar Coordinates.
        Calculated track heading angle measured clockwise from True North.
        Quantum (LSB): 360 / 2^16 degrees (= 360 / 65536 deg ~ 0.005493164 degrees).
        Unit: degrees.
        Range: 0 to 359.9945068 degrees (0 to 65535 LSB).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/200-HEADING, I001/200-HEADING</ast:item>
        <ast:description>Calculated Track Heading</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>360/65536</ast:resolution>
        <ast:lsb>0.005493164 deg</ast:lsb>
        <ast:range min="0" max="359.9945068"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Mode-3/A Code in Octal Representation (0 to 65535) -->
  <xs:simpleType name="Mode3ACodeType">
    <xs:annotation>
      <xs:documentation>
        Item 070: Mode-3/A Code in Octal Representation.
        Mode-3/A transponder squawk reply code with status bits:
        - Bit 16 (V): 0=Code validated, 1=Code not validated
        - Bit 15 (G): 0=Default, 1=Garbled code
        - Bit 14 (L): 0=Mode-3/A code derived from reply, 1=Smoothed by tracker
        - Bit 13: Reserved (set to 0)
        - Bits 12-1: 4-digit octal reply code (A4..A1, B4..B1, C4..C1, D4..D1), range 0000 to 7777.
        Quantum: 1 octal code. Unit: octal squawk code. Range: 0000 to 7777 (raw 0 to 65535).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/070, I001/070</ast:item>
        <ast:description>Mode-3/A Code in Octal Representation</ast:description>
        <ast:unit>octal</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="4095"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Flight Level (LSB = 1/4 FL: 0 to 65535) -->
  <xs:simpleType name="FlightLevelType">
    <xs:annotation>
      <xs:documentation>
        Item 090: Flight Level in Binary Representation.
        Pressure altitude measured by aircraft barometric altimeter transponder:
        - Bit 16 (V): 0=Code validated, 1=Code not validated
        - Bit 15 (G): 0=Default, 1=Garbled code
        - Bits 14-1: Flight Level encoded in signed two's complement.
        Quantum (LSB): 1/4 FL (= 25 feet ~ 7.62 meters).
        Unit: FL (Flight Level; 1 FL = 100 feet).
        Range: -12 FL (-300 ft) to +1270 FL (+127000 ft). Raw range: 0 to 65535.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/090, I001/090</ast:item>
        <ast:description>Flight Level in Binary Representation</ast:description>
        <ast:unit>FL</ast:unit>
        <ast:resolution>1/4</ast:resolution>
        <ast:lsb>0.25 FL (25 ft ~ 7.62 m)</ast:lsb>
        <ast:range min="-12.0" max="1270.0"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Height Measured by 3D Radar (16-bit unsigned, LSB = 25 ft = 1/4 FL) -->
  <xs:simpleType name="Height3dType">
    <xs:annotation>
      <xs:documentation>
        Item 110: Height Measured by a 3D Radar.
        Altitude/height of target above mean sea level measured directly by a 3D primary radar.
        Quantum (LSB): 25 feet (= 1/4 FL ~ 7.62 meters).
        Unit: feet.
        Range: 0 to 819100 feet (0 to 2047.75 FL, 0 to 32764 LSB).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/110</ast:item>
        <ast:description>Height Measured by 3D Radar</ast:description>
        <ast:unit>feet</ast:unit>
        <ast:resolution>25</ast:resolution>
        <ast:lsb>25 ft (1/4 FL)</ast:lsb>
        <ast:range min="0" max="819100"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 24-bit ICAO Aircraft Address (0 to 16777215) -->
  <xs:simpleType name="AircraftAddressType">
    <xs:annotation>
      <xs:documentation>
        Item 220: Aircraft Address.
        Unique 24-bit ICAO technical aircraft address assigned to aircraft transponder.
        Quantum: 1. Unit: 24-bit hexadecimal code. Range: 0x000000 to 0xFFFFFF (0 to 16777215).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/220</ast:item>
        <ast:description>24-bit ICAO Aircraft Address</ast:description>
        <ast:unit>hex</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="16777215"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedInt">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="16777215"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Mode S Comm B Data (56 bits: 7 octets) -->
  <xs:simpleType name="BdsDataType">
    <xs:annotation>
      <xs:documentation>
        Item 250 (BDS Data Subfield): Mode S Comm B Message Data.
        56-bit MB data payload extracted from Mode S Comm-B replies (e.g. BDS 4,0, 5,0, 6,0).
        Quantum: 56 bits (7 octets). Unit: binary hex payload.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/250-DATA</ast:item>
        <ast:description>Mode S Comm B MB Data (56 bits)</ast:description>
        <ast:unit>bytes</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1 bit</ast:lsb>
        <ast:range min="0" max="7"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:hexBinary"/>
  </xs:simpleType>

  <!-- Mode S Comm B Report (7 octets MB data + 1 octet BDS register) -->
  <xs:complexType name="BdsReportType">
    <xs:annotation>
      <xs:documentation>
        Item 250: Mode S Comm B Report.
        Consists of 7 octets (56 bits) of Comm-B MB data followed by 1 octet BDS register code.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/250</ast:item>
        <ast:description>BDS Register Report</ast:description>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="bdsData" type="BdsDataType" dfdl:lengthKind="explicit" dfdl:lengthUnits="bytes" dfdl:length="7"/>
      <xs:element name="bdsReg" type="BdsRegisterType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Mode S BDS Register (0 to 255) -->
  <xs:simpleType name="BdsRegisterType">
    <xs:annotation>
      <xs:documentation>
        Item 250 (BDS Register Subfield): Comm B Data Buffer Identifier.
        Bits 8-5 identify BDS 1, bits 4-1 identify BDS 2:
        - 0x40: BDS 4,0 (Selected Vertical Intent)
        - 0x50: BDS 5,0 (Track and Turn Report)
        - 0x60: BDS 6,0 (Heading and Speed Report)
        Quantum: 1. Unit: hexadecimal register identifier. Range: 0x00 to 0xFF (0 to 255).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/250-BDS</ast:item>
        <ast:description>BDS Register Identifier (BDS 1 and BDS 2)</ast:description>
        <ast:unit>hex</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1</ast:lsb>
        <ast:range min="0" max="255"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Track Status (Primary Subfield: 1 octet = 8 bits) -->
  <xs:complexType name="TrackStatusType">
    <xs:annotation>
      <xs:documentation>
        Item 170: Track Status (Primary Subfield).
        Bitfield indicating status and validity of radar track:
        - Bit 8 (CNF): 0=Confirmed track, 1=Tentative track
        - Bits 7-6 (RAD): 00=Combined, 01=PSR only, 10=SSR/Mode S only, 11=Invalid
        - Bit 5 (DOU): 0=Normal confidence, 1=Low confidence in plot-to-track correlation
        - Bit 4 (MAH): 0=No horizontal manoeuvre detected, 1=Horizontal manoeuvre detected
        - Bits 3-2 (CDM): 00=Maintaining, 01=Climbing, 10=Descending, 11=Unknown
        - Bit 1 (FX): Extension bit (0=End, 1=Extension follows)
        Quantum: Bitfield (1 octet).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
