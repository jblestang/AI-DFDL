      <xs:choice dfdl:choiceDispatchKey="{ if (((dfdlx:lookAhead(0, 8) idiv 64) mod 2) eq 1) then (if ((dfdlx:lookAhead(0, 8) mod 2) eq 1) then xs:string(dfdlx:lookAhead(32, 8)) else xs:string(dfdlx:lookAhead(24, 8))) else 'unknown' }">
