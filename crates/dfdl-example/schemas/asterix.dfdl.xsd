                  dfdl:occursCount="{ if (fn:exists(../trackStatus)) then ../trackStatus/fx else 0 }"/>

      <!-- Item 110: Height Measured by 3D Radar (bit 4 of fspec3 = 8) -->
      <xs:element name="height3d" type="Height3dType" minOccurs="0" maxOccurs="1"
                  dfdl:occursCountKind="expression"
                  dfdl:occursCount="{ if (fn:exists(../fspec3)) then ((../fspec3 idiv 8) mod 2) else 0 }"/>

      <!-- Item 230: Communications / ACAS Capability (bit 2 of fspec3 = 2) -->
      <xs:element name="commCapability" type="CommCapabilityType" minOccurs="0" maxOccurs="1"
                  dfdl:occursCountKind="expression"
                  dfdl:occursCount="{ if (fn:exists(../fspec3)) then ((../fspec3 idiv 2) mod 2) else 0 }"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ========================================================================= -->
  <!-- Category 001: Monoradar Data (Plots and Tracks)                           -->
  <!-- In Eurocontrol ASTERIX Part 2a, a Category 001 Data Block consists of      -->
  <!-- Category (1 octet), Length (2 octets), and one or more plot/track records. -->
  <!-- ========================================================================= -->
  <xs:complexType name="Cat001RecordType">
    <xs:sequence>
      <xs:element name="category" type="DataCategoryType"/>
      <xs:element name="length" type="BlockLengthType"/>
      <!-- Repeating plot/track records within this Category 001 Data Block -->
      <xs:element name="record" type="Cat001RecordItemType" minOccurs="1" maxOccurs="unbounded" dfdl:occursCountKind="parsed"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Cat001RecordItemType">
    <xs:sequence>
      <!-- FSPEC (2 octets) -->
      <xs:element name="fspec1" type="Fspec1Type"/>
      <xs:element name="fspec2" type="Fspec2Type"/>
      <!-- Item 010: Data Source Identifier -->
      <xs:element name="sac" type="SacType"/>
      <xs:element name="sic" type="SicType"/>
      <!-- Item 020: Target Report Descriptor -->
      <xs:element name="targetDescriptor" type="TargetDescriptorType"/>
      <!-- Item 161: Track Number -->
      <xs:element name="trackNumber" type="TrackNumberType"/>
      <!-- Item 040: Measured Position in Polar Coordinates -->
      <xs:element name="rho" type="PolarDistanceType"/>
      <xs:element name="theta" type="PolarAzimuthType"/>
      <!-- Item 042: Calculated Position in Cartesian Coordinates -->
      <xs:element name="cartesianX" type="CartesianCoordinateType"/>
      <xs:element name="cartesianY" type="CartesianCoordinateType"/>
      <!-- Item 200: Calculated Track Velocity in Polar Coordinates -->
      <xs:element name="groundSpeed" type="GroundSpeedType"/>
      <xs:element name="heading" type="HeadingType"/>
      <!-- Item 070: Mode-3/A Code in Octal Representation -->
      <xs:element name="mode3a" type="Mode3ACodeType"/>
      <!-- Item 090: Flight Level in Binary Representation -->
      <xs:element name="flightLevel" type="FlightLevelType"/>
      <!-- Item 141: Truncated Time of Day (LSB = 1/128 s) -->
      <xs:element name="truncatedTimeOfDay" type="TruncatedTimeOfDayType"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ========================================================================= -->
  <!-- Category 002: Monoradar Service Messages                                  -->
  <!-- ========================================================================= -->
  <xs:complexType name="Cat002RecordType">
    <xs:sequence>
      <xs:element name="category" type="DataCategoryType"/>
      <xs:element name="length" type="BlockLengthType"/>
      <!-- FSPEC (2 octets) -->
      <xs:element name="fspec1" type="Fspec1Type"/>
      <xs:element name="fspec2" type="Fspec2Type"/>
      <!-- Item 010: Data Source Identifier -->
      <xs:element name="sac" type="SacType"/>
      <xs:element name="sic" type="SicType"/>
      <!-- Item 000: Message Type -->
      <xs:element name="messageType" type="MessageTypeType"/>
      <!-- Fields mandatory or optional according to messageType -->
      <xs:choice dfdl:choiceDispatchKey="{ xs:string(messageType) }">
        <!-- Message Type 1: North Marker Message -->
        <xs:element name="northMarker" type="Cat002NorthMarkerType" dfdl:choiceBranchKey="1"/>
        <!-- Message Type 2: Sector Crossing Message -->
        <xs:element name="sectorCrossing" type="Cat002SectorCrossingType" dfdl:choiceBranchKey="2"/>
        <!-- Message Type 3: Station Status Message -->
        <xs:element name="stationStatus" type="Cat002StatusType" dfdl:choiceBranchKey="3"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>

  <!-- Cat 002 North Marker: Sector Number is NOT present, Antenna Rotation Period IS present -->
  <xs:complexType name="Cat002NorthMarkerType">
    <xs:sequence>
      <!-- Item 030: Time of Day (24-bit, LSB = 1/128 s) -->
      <xs:element name="timeOfDay" type="TimeOfDayType" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="24"/>
      <!-- Item 041: Antenna Rotation Period (LSB = 1/128 s) - Mandatory for North Marker -->
      <xs:element name="antennaRotationPeriod" type="AntennaRotationPeriodType"/>
      <!-- Item 050 & 060: Station Configuration Status & Processing Mode (Optional) -->
      <xs:element name="stationConfig" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" dfdl:occursCountKind="parsed"/>
      <xs:element name="stationProcessingMode" type="xs:unsignedByte" minOccurs="0" maxOccurs="1" dfdl:occursCountKind="parsed"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Cat 002 Sector Crossing: Sector Number IS present and mandatory, Antenna Rotation Period is NOT present -->
  <xs:complexType name="Cat002SectorCrossingType">
    <xs:sequence>
      <!-- Item 020: Sector Number - Mandatory for Sector Crossing -->
      <xs:element name="sectorNumber" type="SectorNumberType"/>
      <!-- Item 030: Time of Day (24-bit, LSB = 1/128 s) -->
      <xs:element name="timeOfDay" type="TimeOfDayType" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="24"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Cat 002 Station Status Message -->
  <xs:complexType name="Cat002StatusType">
    <xs:sequence>
      <!-- Item 030: Time of Day -->
      <xs:element name="timeOfDay" type="TimeOfDayType" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="24"/>
      <!-- Item 050: Station Configuration Status (Mandatory) -->
      <xs:element name="stationConfig" type="xs:unsignedByte"/>
      <!-- Item 060: Station Processing Mode (Mandatory) -->
      <xs:element name="stationProcessingMode" type="xs:unsignedByte"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
