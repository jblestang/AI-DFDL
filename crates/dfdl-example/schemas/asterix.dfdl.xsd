        Quantum (LSB): 1 dBm.
        Unit: dBm.
        Range: 0 to 255 dBm.
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/130-PAM</ast:item>
        <ast:description>Primary Plot Amplitude</ast:description>
        <ast:unit>dBm</ast:unit>
        <ast:resolution>1</ast:resolution>
        <ast:lsb>1 dBm</ast:lsb>
        <ast:range min="0" max="255"/>
