            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="7"/>
            <ast:enum value="0" label="No alert / Airborne"/>
            <ast:enum value="1" label="No alert / Ground"/>
            <ast:enum value="2" label="Alert / Airborne"/>
            <ast:enum value="3" label="Alert / Ground"/>
            <ast:enum value="4" label="Alert + SPI"/>
            <ast:enum value="5" label="SPI"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="si" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>SI: SI Code Capability (0=SI code capable, 1=II code capable)</xs:documentation>
