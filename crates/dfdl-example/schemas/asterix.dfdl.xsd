    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Difference in Range PSR - SSR (1 octet, LSB = 1/256 NM) -->
  <xs:simpleType name="RpdType">
    <xs:annotation>
      <xs:documentation>
        Item 130 Subfield 6: Difference in Range between PSR and SSR plots (RPD = PSR - SSR).
        Quantum (LSB): 1/256 NM (~7.2297 meters). Encoded as two's complement.
        Unit: Nautical Miles (NM).
        Range: [-128/256 NM, +127/256 NM] = [-0.5 NM, +0.49609375 NM].
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/130-RPD</ast:item>
        <ast:description>Range Difference (PSR - SSR)</ast:description>
        <ast:unit>NM</ast:unit>
        <ast:resolution>1/256</ast:resolution>
        <ast:lsb>0.00390625 NM (~7.2297 m)</ast:lsb>
        <ast:range min="-0.5" max="0.49609375"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Difference in Azimuth PSR - SSR (1 octet, LSB = 360 / 2^14 deg) -->
  <xs:simpleType name="ApdType">
    <xs:annotation>
      <xs:documentation>
        Item 130 Subfield 7: Difference in Azimuth between PSR and SSR plots (APD = PSR - SSR).
        Quantum (LSB): 360 / 2^14 degrees (= 360 / 16384 deg ~ 0.02197265625 degrees). Encoded as two's complement.
        Unit: degrees.
        Range: [-128 * (360/16384)°, +127 * (360/16384)°] = [-2.8125°, +2.79052734375°].
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/130-APD</ast:item>
        <ast:description>Azimuth Difference (PSR - SSR)</ast:description>
        <ast:unit>degrees</ast:unit>
        <ast:resolution>360/16384</ast:resolution>
        <ast:lsb>0.02197265625 deg</ast:lsb>
        <ast:range min="-2.8125" max="2.79052734375"/>
      </xs:appinfo>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

