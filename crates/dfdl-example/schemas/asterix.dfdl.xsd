            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="7"/>
            <ast:enum value="0" label="No comm"/>
            <ast:enum value="1" label="Comm A/B (16 BDS)"/>
            <ast:enum value="2" label="Comm A/B + Uplink ELM"/>
            <ast:enum value="3" label="Comm A/B + Up/Down ELM"/>
            <ast:enum value="4" label="Level 5 transponder"/>
          </xs:appinfo>
        </xs:annotation>
      </xs:element>
      <xs:element name="stat" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="3" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
