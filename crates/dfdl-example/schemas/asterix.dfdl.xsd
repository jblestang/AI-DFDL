  <!-- Communications / ACAS Capability (2 octets = 16 bits) -->
  <xs:complexType name="CommCapabilityType">
    <xs:annotation>
      <xs:documentation>
        Item 230: Communications / ACAS Capability and Flight Status.
        2-octet field encoding transponder capability and flight status:
        - Bits 16-14 (COM): Communications capability (0=No comm, 1=Comm A/B, 2=Up ELM, 3=Up/Down ELM, 4=Level 5)
        - Bits 13-11 (STAT): Flight status (0=Airborne no alert/SPI, 1=Ground no alert/SPI, 2=Airborne alert, 3=Ground alert, 4=Alert+SPI, 5=SPI only)
        - Bit 10 (SI): SI/II capability (0=SI code capable, 1=II code capable)
        - Bit 9 (spare): Reserved (0)
        - Bit 8 (MSSC): Mode S Specific Service Capability (0=No, 1=Yes)
        - Bit 7 (ARC): Altitude Reporting Capability (0=100 ft, 1=25 ft)
        - Bit 6 (AIC): Aircraft Identification Capability (0=No, 1=Yes)
        - Bit 5 (B1A): BDS 0,5 bit 16 status
        - Bits 4-1 (B1B): BDS 0,5 bits 37-40
        Quantum: Bitfield (2 octets = 16 bits).
      </xs:documentation>
      <xs:appinfo source="urn:eurocontrol:asterix">
        <ast:item>I048/230</ast:item>
        <ast:description>Communications / ACAS Capability and Flight Status</ast:description>
        <ast:unit>bitfield</ast:unit>
      </xs:appinfo>
    </xs:annotation>
    <xs:sequence dfdl:alignment="1" dfdl:alignmentUnits="bits">
