      </xs:element>
      <xs:element name="spare" type="xs:unsignedByte" dfdl:lengthKind="explicit" dfdl:lengthUnits="bits" dfdl:length="1" dfdl:alignment="1" dfdl:alignmentUnits="bits">
        <xs:annotation>
          <xs:documentation>Spare bit (set to 0)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/230.SPARE</ast:item>
            <ast:description>Spare bit</ast:description>
            <ast:unit>code</ast:unit>
