        <xs:annotation>
          <xs:documentation>AIC: Aircraft Identification Capability (0=No, 1=Yes)</xs:documentation>
          <xs:appinfo source="urn:eurocontrol:asterix">
            <ast:item>I048/230.AIC</ast:item>
            <ast:description>Aircraft Identification Capability</ast:description>
            <ast:unit>code</ast:unit>
            <ast:resolution>1</ast:resolution>
            <ast:range min="0" max="1"/>
