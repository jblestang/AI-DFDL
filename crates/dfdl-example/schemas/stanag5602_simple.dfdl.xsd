<?xml version="1.0" encoding="UTF-8"?>
<!--
  NATO STANAG 5602: Standard Interface for Multiple Platform Link Evaluation (SIMPLE)
  DFDL Schema definition for military tactical data link IP encapsulation (Link 16, Link 11, Link 22, VMF).
-->
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/"
    xmlns:dfdlx="http://www.ogf.org/dfdl/dfdl-1.0/extensions"
    xmlns:fn="http://www.w3.org/2005/xpath-functions"
    xmlns:simple="urn:nato:stanag:5602:simple">

  <xs:annotation>
    <xs:appinfo source="http://www.ogf.org/dfdl/">
      <dfdl:format
          representation="binary"
          byteOrder="bigEndian"
          bitOrder="mostSignificantBitFirst"
          binaryNumberRep="binary"
          lengthUnits="bytes"
          alignment="1"
          alignmentUnits="bytes"
          lengthKind="implicit"
          leadingSkip="0"
          trailingSkip="0"
          initiator=""
          terminator=""
          separator=""
          encoding="ISO-8859-1"
          textBidi="no"
          floating="no"
          fillByte="%#r00;"
          calendarPatternKind="explicit"
          calendarPattern="hhmmss"
          calendarTimeZone="UTC"
          occursCountKind="implicit"
      />
    </xs:appinfo>
  </xs:annotation>

  <!-- ========================================================================= -->
  <!-- Strict Simple Types with NATO Constraints and Numerical Facets            -->
  <!-- ========================================================================= -->

  <!-- NATO STANAG 5602 Framing Synchronization Byte 1: Strict 0x49 ('I', 73 decimal) -->
  <xs:simpleType name="SyncByte1Type">
    <xs:annotation>
      <xs:documentation>
        NATO STANAG 5602 Network Synchronization Byte 1:
        Strictly 0x49 (ASCII 'I', 73 decimal) framing byte for Wireshark and hardware decoders.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:enumeration value="73"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- NATO STANAG 5602 Framing Synchronization Byte 2: Strict 0x36 ('6', 54 decimal) -->
  <xs:simpleType name="SyncByte2Type">
    <xs:annotation>
      <xs:documentation>
        NATO STANAG 5602 Network Synchronization Byte 2:
        Strictly 0x36 (ASCII '6', 54 decimal) framing byte for Wireshark and hardware decoders.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:enumeration value="54"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- STANAG 5602 Total Frame Length in octets (16 to 517 octets, Little-Endian) -->
  <xs:simpleType name="SimpleLengthType">
    <xs:annotation>
      <xs:documentation>
        Total length of the STANAG 5602 frame in octets (14-byte header + payload + 2-byte checksum).
        Wireshark packet-simple.c requires 16 &lt;= length &lt; 518.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="16"/>
      <xs:maxInclusive value="517"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Monotonic Sequence Counter (0 to 65535, Little-Endian) -->
  <xs:simpleType name="SequenceNumberType">
    <xs:annotation>
      <xs:documentation>Monotonic 16-bit sequence counter (Little-Endian).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Node Identifier (0 to 255) -->
  <xs:simpleType name="NodeType">
    <xs:annotation>
      <xs:documentation>Platform, terminal or radio node identifier (0 to 255, 129 = Broadcast).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Subnode Identifier (0 to 255) -->
  <xs:simpleType name="SubnodeType">
    <xs:annotation>
      <xs:documentation>Subnode identifier (0 to 255, e.g. 206 for Link 16, 6 for Status, 7 for TimeSync).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Packet Size in 16-bit words (min 4 words = 8 bytes) -->
  <xs:simpleType name="PacketSizeType">
    <xs:annotation>
      <xs:documentation>
        Packet size in 16-bit words. Wireshark expects packet_size * 2 &gt;= 8, so packetSize &gt;= 4.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="4"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Packet Type (1 = Link 16, 61 = Status/Control) -->
  <xs:simpleType name="PacketTypeType">
    <xs:annotation>
      <xs:documentation>
        STANAG 5602 Packet Type:
        - 1: Link 16 (STANAG 5516 / TADIL J)
        - 61: SIMPLE Status / Control Management
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedByte">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="255"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Transit Time (0 to 65535, Little-Endian) -->
  <xs:simpleType name="TransitTimeType">
    <xs:annotation>
      <xs:documentation>Packet transit time in milliseconds or units specified by protocol (Little-Endian).</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:unsignedShort">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="65535"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ========================================================================= -->
  <!-- Layer 2: Tactical Data Link Included Sub-Schemas                          -->
  <!-- ========================================================================= -->

  <!-- Include NATO STANAG 5602 Native Control & Management Schemas (packetType = 61) -->
  <xs:include schemaLocation="stanag5602_control.dfdl.xsd"/>

  <!-- Include Link 16 (STANAG 5516 / TADIL J) J-Series Message Definitions (packetType = 1) -->
  <xs:include schemaLocation="link16.dfdl.xsd"/>

  <!-- ========================================================================= -->
  <!-- Top-Level Root Elements                                                   -->
  <!-- ========================================================================= -->

  <!-- A single STANAG 5602 (SIMPLE) Packet -->
  <xs:element name="SimplePacket" type="SimplePacketType"/>

  <!-- A stream or capture of multiple sequential STANAG 5602 (SIMPLE) Packets -->
  <xs:element name="SimpleStream" type="SimpleStreamType"/>

  <!-- ========================================================================= -->
  <!-- Complex Types                                                             -->
  <!-- ========================================================================= -->

  <xs:complexType name="SimpleStreamType">
    <xs:sequence>
      <xs:element name="packet" type="SimplePacketType" minOccurs="0" maxOccurs="unbounded" dfdl:occursCountKind="parsed"/>
    </xs:sequence>
  </xs:complexType>

  <!-- Standard STANAG 5602 (SIMPLE) Packet Structure matching Wireshark packet-simple.c -->
  <xs:complexType name="SimplePacketType">
    <xs:sequence>
      <!-- Network Header (6 octets) -->
      <xs:element name="sync1" type="SyncByte1Type" default="73"/>
      <xs:element name="sync2" type="SyncByte2Type" default="54"/>
      <xs:element name="length" type="SimpleLengthType" dfdl:byteOrder="littleEndian"/>
      <xs:element name="sequenceNumber" type="SequenceNumberType" dfdl:byteOrder="littleEndian"/>

      <!-- Packet Header (8 octets) -->
      <xs:element name="sourceNode" type="NodeType"/>
      <xs:element name="sourceSubnode" type="SubnodeType"/>
      <xs:element name="destinationNode" type="NodeType"/>
      <xs:element name="destinationSubnode" type="SubnodeType"/>
      <xs:element name="packetSize" type="PacketSizeType"/>
      <xs:element name="packetType" type="PacketTypeType"/>
      <xs:element name="transitTime" type="TransitTimeType" dfdl:byteOrder="littleEndian"/>

      <!-- Layer 2 Payload: Polymorphic Dispatch on packetType (1 = Link 16, 61 = SIMPLE Control) -->
      <xs:choice dfdl:choiceDispatchKey="{ xs:string(packetType) }">
        <!-- Link 16 J-Series Tactical Data Link Payload (Wireshark packetType = 1, legacy = 3) -->
        <xs:element name="link16" type="Link16PayloadType" dfdl:choiceBranchKey="1" dfdlx:choiceBranchKeyRanges="3 3"/>
        <!-- Native STANAG 5602 Management & Control Payload (Wireshark packetType = 61, legacy = 0) -->
        <xs:element name="control" type="SimpleControlPayloadType" dfdl:choiceBranchKey="61" dfdlx:choiceBranchKeyRanges="0 0"/>
      </xs:choice>

      <!-- Frame Checksum (2 octets, Little-Endian additive sum of octets 0..length-2) -->
      <xs:element name="checksum" type="xs:unsignedShort" dfdl:byteOrder="littleEndian"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>
